{
  "name": "pi-better-ux",
  "version": "0.1.0",
  "description": "Pi Coding Agent UX and productivity extension pack",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Edward-lyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edward-lyz/pi-edward-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Edward-lyz/pi-edward-plugins/issues"
  },
  "homepage": "https://github.com/Edward-lyz/pi-edward-plugins#readme",
  "files": [
    "packages/*/package.json",
    "packages/*/src/**",
    "packages/*/config/**",
    "packages/*/README.md",
    "packages/*/CHANGELOG.md",
    "packages/*/LICENSE",
    "README.md",
    "install.sh",
    "LICENSE"
  ],
  "scripts": {
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.9.4",
    "@shikijs/cli": "^4.0.2",
    "better-result": "^2.8.2",
    "diff": "^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "packages/claude-style-tools/src/index.ts",
      "packages/claude-style-tools/src/spinner.ts",
      "packages/code-block-fix/src/code-block-fix.ts",
      "packages/rtk/src/rtk.ts",
      "packages/statusline/src/statusline.ts",
      "packages/system-context/src/system-context.ts",
      "packages/subagent/src/index.ts",
      "packages/usage-report/src/usage-report.ts",
      "packages/fff/src/index.ts",
      "packages/agent-loop/src/index.ts"
    ]
  }
}
