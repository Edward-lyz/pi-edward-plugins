{
  "name": "pi-fff-pack",
  "version": "0.1.0",
  "description": "FFF-powered fuzzy file resolution, content search, and read/grep enhancement for pi",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent",
    "fuzzy-find",
    "grep",
    "fff"
  ],
  "author": "Shpetim Alimi (forked by Edward-lyz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edward-lyz/pi-edward-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Edward-lyz/pi-edward-plugins/issues"
  },
  "homepage": "https://github.com/Edward-lyz/pi-edward-plugins/tree/main/packages/fff#readme",
  "dependencies": {
    "@ff-labs/fff-node": "^0.9.4",
    "better-result": "^2.8.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
